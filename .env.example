# Copy this file to .env and adjust it.
# Local development (nothing to install): SQLite
DATABASE_URL=sqlite:///./gc_dev.db
# PostgreSQL (staging/production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gc

# GC-3 Auth — change JWT_SECRET in production
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_DEBUG=true

# Upload de laudos + assinatura digital (base)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
# Optional dedicated key for HMAC signatures (defaults to JWT_SECRET)
SIGNING_KEY=
